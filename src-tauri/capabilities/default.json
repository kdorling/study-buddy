{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://generativelanguage.googleapis.com/*"
        }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**/*"
        }
      ]
    },
    "store:default"
  ]
}